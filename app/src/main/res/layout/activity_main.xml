<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻装出行" android:textSize="32sp" android:textColor="#19352F" android:layout_marginBottom="10dp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="先整理清单，再安心出发。" android:textSize="14sp" android:textColor="#19352F" android:layout_marginBottom="10dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01  这次去哪里" android:textSize="18sp" android:textColor="#19352F" android:layout_marginBottom="10dp" android:textStyle="bold"/>
                <EditText android:id="@+id/destination" android:layout_width="match_parent" android:layout_height="52dp" android:singleLine="true" android:maxLength="30" android:inputType="textCapSentences" android:hint="目的地，例如杭州"/>
                <EditText android:id="@+id/days" android:layout_width="match_parent" android:layout_height="52dp" android:singleLine="true" android:maxLength="3" android:inputType="number" android:hint="出行天数，1 至 30 天"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="交通方式" android:textSize="14sp" android:textColor="#19352F" android:layout_marginBottom="10dp" android:layout_marginTop="10dp"/>
                <Spinner android:id="@+id/transport" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02  按需准备" android:textSize="18sp" android:textColor="#19352F" android:layout_marginBottom="10dp" android:textStyle="bold"/>
                <RadioGroup android:id="@+id/purpose" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@+id/leisure">
                    <RadioButton android:id="@+id/leisure" android:layout_width="wrap_content" android:layout_height="48dp" android:text="休闲旅行"/>
                    <RadioButton android:id="@+id/business" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:text="商务出行"/>
                </RadioGroup>
                <CheckBox android:id="@+id/electronics" android:layout_width="match_parent" android:layout_height="48dp" android:text="携带额外电子设备"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生成后可补充物品，勾选标记已装包。" android:textSize="12sp" android:textColor="#19352F" android:layout_marginBottom="10dp"/>
            </LinearLayout>
            <Button android:id="@+id/generate" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="生成行李清单" android:textColor="#FFFFFF" android:backgroundTint="#167567"/>
            <Button android:id="@+id/resume" android:layout_width="match_parent" android:layout_height="48dp" android:text="继续上次清单"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageButton android:id="@+id/reset" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_reset" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="重置本页表单"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="重置表单" android:textSize="12sp" android:textColor="#19352F" android:layout_marginBottom="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="陈翊轩  |  2406100303" android:textSize="13sp" android:textColor="#19352F" android:layout_marginBottom="10dp" android:gravity="center" android:layout_marginTop="12dp"/>
</LinearLayout>
